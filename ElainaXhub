local mfly1, mfly2
local function getRoot(c) return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") end
function unmobilefly(p)
    pcall(function()
        _G.FLY = false
        local c = p.Character
        if c then
            local r = getRoot(c)
            if r then
                local vh = r:FindFirstChild("VelocityHandler")
                local gh = r:FindFirstChild("GyroHandler")
                if vh then vh:Destroy() end
                if gh then gh:Destroy() end
                local h = c:FindFirstChildWhichIsA("Humanoid")
                if h then h.PlatformStand = false end
            end
        end
        if mfly1 then mfly1:Disconnect() end
        if mfly2 then mfly2:Disconnect() end
    end)
end
function mobilefly(p)
    unmobilefly(p)
    _G.FLY = true
    local c = p.Character
    local r = getRoot(c)
    if c and r then
        local cam = workspace.CurrentCamera
        local v3inf = Vector3.new(9e9,9e9,9e9)
        local cm = require(p.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
        local bv = Instance.new("BodyVelocity")
        bv.Name = "VelocityHandler"
        bv.Parent = r
        bv.MaxForce = Vector3.new()
        bv.Velocity = Vector3.new()
        local bg = Instance.new("BodyGyro")
        bg.Name = "GyroHandler"
        bg.Parent = r
        bg.MaxTorque = v3inf
        bg.P = 1000
        bg.D = 2
        mfly1 = p.CharacterAdded:Connect(function() unmobilefly(p); mobilefly(p) end)
        mfly2 = RunService.RenderStepped:Connect(function()
            r = getRoot(p.Character)
            cam = workspace.CurrentCamera
            if p.Character and p.Character:FindFirstChildWhichIsA("Humanoid") and r and r:FindFirstChild("VelocityHandler") and r:FindFirstChild("GyroHandler") then
                local vel = r:FindFirstChild("VelocityHandler")
                local gyro = r:FindFirstChild("GyroHandler")
                if vel and gyro then
                    vel.MaxForce = v3inf
                    gyro.MaxTorque = v3inf
                    gyro.CFrame = cam.CoordinateFrame
                    vel.Velocity = Vector3.new()
                    local dir = cm:GetMoveVector()
                    if dir.X ~= 0 or dir.Z ~= 0 then
                        local mv = Vector3.new(dir.X,0,dir.Z).unit
                        local right = cam.CFrame.RightVector
                        local forward = cam.CFrame.LookVector
                        local flyDir = (right * mv.X - forward * mv.Z).unit
                        vel.Velocity = flyDir * (_G.flySpeed or 20) * 20
                    end
                end
            end
        end)
    end
end
_G.flySpeed = 20

