local autoBounceActive = false
local bounceConnection = nil
local autoBouncePower = 50
local autoBounceDistance = 5

function updateBounceLogic()
    if bounceConnection then bounceConnection:Disconnect(); bounceConnection = nil end
    if not autoBounceActive then return end
    bounceConnection = RunService.Heartbeat:Connect(function()
        local character = LocalPlayer.Character
        if not (character and character.Parent) then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if rootPart and humanoid and humanoid.Health > 0 and rootPart.Velocity.Y <= 0 then
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {character}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            local raycastResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -(autoBounceDistance + 2), 0), raycastParams)
            if raycastResult then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                rootPart.Velocity = Vector3.new(rootPart.Velocity.X, autoBouncePower, rootPart.Velocity.Z)
            end
        end
    end)
end

