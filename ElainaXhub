    pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local hum = char.Humanoid
            
            -- Cập nhật Speed & Jump
            if DConfiguration.Misc.PlayerAdjustment.Update then
                local adj = DConfiguration.Misc.PlayerAdjustment.Update
                if adj.Speed then hum.WalkSpeed = adj.Speed end
                if adj.JumpHeight then hum.JumpPower = adj.JumpHeight end
            end
            
            -- Cập nhật Walkspeed CFrame
            if DConfiguration.Misc.WalkspeedCF then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and hum.MoveDirection.Magnitude > 0 then
                    hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (DConfiguration.Misc.WalkspeedValue or 1) * 0.1)
                end
            end
        end
    end)
end)

