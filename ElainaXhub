local cactusData = { Enabled = false, Size = 10, Transparency = 0.1, List = {} }
function ClearPlates()
    for _, p in pairs(cactusData.List) do if p and p.Parent then p:Destroy() end end
    cactusData.List = {}
end
function CreatePlates()
    ClearPlates()
    if not cactusData.Enabled then return end
    local g = workspace:FindFirstChild("Game")
    local m = g and g:FindFirstChild("Map")
    local p = m and m:FindFirstChild("Parts")
    local folder = p and p:FindFirstChild("ImmovableProps")
    if not folder then return end
    for _, obj in pairs(folder:GetChildren()) do
        if obj.Name == "Cactus1" or obj.Name == "Cactus2" then
            local pos, size
            if obj:IsA("Model") then
                local cf, s = obj:GetBoundingBox()
                pos, size = cf.Position, s
            elseif obj:IsA("BasePart") then
                pos, size = obj.Position, obj.Size
            end
            if pos and size then
                local part = Instance.new("Part")
                part.Name = "PhantomWyrm"
                part.Size = Vector3.new(cactusData.Size, 1, cactusData.Size)
                part.Anchored, part.CanCollide = true, true
                part.Material = Enum.Material.Neon
                part.Transparency = cactusData.Transparency
                part.Color = Color3.fromRGB(0, 255, 150)
                part.Position = pos + Vector3.new(0, (size.Y / 2) + 0.5, 0)
                part.Parent = workspace
                table.insert(cactusData.List, part)
            end
        end
    end
end
task.spawn(function()
    while task.wait(3) do
        if cactusData.Enabled and #cactusData.List == 0 then CreatePlates() end
    end
end)

