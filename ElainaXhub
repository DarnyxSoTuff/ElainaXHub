-- 7. EASY BOUNCE (GIỮ NGUYÊN LOGIC)
-- =====================================================================
local EB = { Enabled = false, Mode = "Forward", BaseSpeed = 50, ExtraSpeed = 100 }
local stateEB = { speed = EB.BaseSpeed, last = tick(), airTick = 0, airSum = 0, airborne = false, bv = nil }
RunService.RenderStepped:Connect(function()
    local ch = LocalPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChild("Humanoid")
    if _G.FLY or not EB.Enabled or not hrp or not hum then
        if stateEB.bv then stateEB.bv:Destroy(); stateEB.bv = nil end
        return
    end
    local dt = tick() - stateEB.last; stateEB.last = tick()
    local inAir = hum.FloorMaterial == Enum.Material.Air
    if stateEB.airborne and not inAir then
        stateEB.speed = math.max(EB.BaseSpeed, stateEB.speed - 10)
        stateEB.airSum = 0
    end
    stateEB.airborne = inAir
    if inAir then
        stateEB.airSum = stateEB.airSum + dt
        stateEB.airTick = stateEB.airTick + dt
        while stateEB.airTick >= 0.04 do
            stateEB.airTick = stateEB.airTick - 0.04
            stateEB.speed = math.min(EB.BaseSpeed + EB.ExtraSpeed, stateEB.speed + 0.1)
        end
    else
        stateEB.airTick, stateEB.airSum = 0, 0
        stateEB.speed = math.max(EB.BaseSpeed, stateEB.speed - (2.5 * dt))
    end
    if not stateEB.bv or stateEB.bv.Parent ~= hrp then
        if stateEB.bv then stateEB.bv:Destroy() end
        stateEB.bv = Instance.new("BodyVelocity")
        stateEB.bv.Parent = hrp
    end
    local camDir = Camera.CFrame.LookVector
    local moveDir = Vector3.new(camDir.X, 0, camDir.Z).Unit
    if EB.Mode == "Back" then moveDir = -moveDir end
    stateEB.bv.Velocity = moveDir * stateEB.speed
    stateEB.bv.MaxForce = Vector3.new(4e5, 0, 4e5)
end)

