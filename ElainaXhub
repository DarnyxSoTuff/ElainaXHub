function Normalize(str) return str:lower():gsub("%s+", "") end
function FindRealName(folder, input)
    local norm = Normalize(input)
    for _, item in pairs(folder:GetChildren()) do
        if Normalize(item.Name) == norm then return item.Name end
    end
    return nil
end
function ChangeCosmetics(name1, name2)
    local cosmetics = ReplicatedStorage.Items.Cosmetics
    local r1 = FindRealName(cosmetics, name1)
    local r2 = FindRealName(cosmetics, name2)
    if r1 and r2 then
        local a = cosmetics:FindFirstChild(r1)
        local b = cosmetics:FindFirstChild(r2)
        if a and b then a.Name = r2; task.wait(); b.Name = r1 end
    end
end
function ChangeEmotes(name1, name2)
    local emotes = ReplicatedStorage.Items.Emotes
    local r1 = FindRealName(emotes, name1)
    local r2 = FindRealName(emotes, name2)
    if r1 and r2 then
